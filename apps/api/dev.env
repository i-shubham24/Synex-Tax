# Local development only: the PGlite PostgreSQL 17 started by `npm run db:dev -w @synextax/db`.
# No secrets here; production values come from the deployment environment.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_POOL_MAX=1
PORT=4000
