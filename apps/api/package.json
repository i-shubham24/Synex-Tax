{
  "name": "@synextax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "npm run build:deps && tsc",
    "build:deps": "npm run build --prefix ../../packages/gsp-adapter && npm run build --prefix ../../packages/shared-schemas && npm run build --prefix ../../packages/tax-engine && npm run build --prefix ../../packages/ingestion && npm run build --prefix ../../workers/queue-worker",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "test": "node --env-file=test.env --test dist/**/*.test.js",
    "lint": "tsc --noEmit",
    "dev:local": "tsx watch --env-file=dev.env src/server.ts",
    "agent-key": "node scripts/agent-key.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "2.2.2",
    "@synextax/gsp-adapter": "*",
    "@synextax/ingestion": "*",
    "@synextax/queue-worker": "*",
    "@synextax/shared-schemas": "*",
    "@synextax/tax-engine": "*",
    "decimal.js": "^10.5.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.11.1",
    "pg": "^8.13.3",
    "qrcode": "1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@synextax/db": "*",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
