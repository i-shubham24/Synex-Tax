{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/practice/automation/run",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/v1/backups/check-late",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/v1/assistant/feed/refresh",
      "schedule": "30 1 * * *"
    }
  ]
}
